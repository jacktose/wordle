#!/bin/bash

# echo "nargs: $#"
# argarr=("$@")
# echo "lenargs: ${#argarr[@]}"
# echo "nargmod: $(($# % 2))"
# case $# in
#     2 | 4 | 6 | 8 | 10 ) :;;
#     * ) echo >&2 "Must provide 2, 4, 6, 8, or 10 args.";;
# esac
if (($# % 2)) || (($# < 2)) || (($# > 10)); then
    echo >&2 "Must provide 2, 4, 6, 8, or 10 args."
    exit $(($# + 100))
fi
n_args=$#

while (( $# > 0 )); do
    guess="${1,,}"
    result="${2//[-_]/.}"
    [[ "$guess" =~ ^[a-zA-Z]{5}$ ]] || { echo >&2 "Invalid guess: $guess"; exit 99; }
    [[ "$result" =~ ^[.a-zA-Z]{5}$ ]] || { echo >&2 "Invalid result: $result"; exit 99; }
    [[ "$guess" =~ ${result,,} ]] || { echo >&2 "Result ${result} does not match guess ${guess}."; exit 99; }
    if (( ${#guess} != 5 || ${#result} != 5 )); then
        # TODO: allow single-char null result?
        echo >&2 "Args must be 5 characters long."
        exit 99
    fi

    declare -a answer yellows
    declare -l grays
    declare display='\E[1;37m'
    for (( i=0; i<${#result}; i++ )); do
        guess_char="${guess:$i:1}"
        result_char="${result:$i:1}"
        case "$result_char" in
            [[:upper:]] ) answer[$i]="$guess_char"; display+="\E[48;2;0;128;0m";;
            [[:lower:]] ) yellows[$i]+="$guess_char"; display+="\E[48;2;193;156;0m";;  # TODO: Handle secondary yellows!
            . ) grays+="$guess_char"; display+="\E[48;5;240m";;  # TODO: Handle secondary grays!
            # e.g. ./wordle sLaTe S.... hokum .o... scorn S.O.n snoop SNO.. ?
        esac
        display+="${guess_char^^}"
    done
    display+='\E[0m'
    [ -t 1 ] && echo -e "$display"

    shift 2
done

# declare -p answer yellows grays

# WordleBot recommended second guesses
if [ -t 1 ] && (( $n_args == 2 )) && [[ -r "_bot_$guess" ]]; then
    while read -r key rec; do
        if [[ "${key//[-_]/.}" = "$result" ]]; then
            [[ -n "$rec" ]] && echo "WordleBot recommends: $rec"
            break
        fi
    done < "_bot_$guess" 
fi

declare -l pattern='/^'
for (( i=0; i<5; i++ )); do
    if [[ -v answer[$i] ]]; then
        pattern+="${answer[$i]}"
    elif (( ${#yellows[$i]} || ${#grays} )); then
        pattern+="[^${yellows[$i]}${grays}]"
    else
        pattern+='.'
    fi
done
pattern+='$/'
# declare -p pattern
printf -v all_yellows '%s' "${yellows[@]}"
printf -v all_greens '%s' "${answer[@]}"
all_yellows="${all_yellows//[$all_greens]}"
all_yellows="$(<<< "$all_yellows" fold -w 1 | sort -u)"
while read y; do
    pattern+=" && /$y/"
done <<< "$all_yellows"
[ -t 1 ] && echo "awk '$pattern' words"
poss="$(awk "$pattern" words)"
#declare -p poss >&2
if [ -t 1 ]; then
    if [[ -z "$poss" ]]; then
        echo "No possible answers! Check your inputs."
        exit
    fi
    echo "$(wc -l <<< "${poss[@]}") possible answers:"
    args=''; (($(tput cols) > 80)) && args='--output-width 80'
    <<< "${poss[@]}" column $args
else
    echo "${poss}"
fi
