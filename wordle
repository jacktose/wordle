# echo "nargmod: $(($# % 2))"
# case $# in
#     2 | 4 | 6 | 8 | 10 ) :;;
#     * ) echo >&2 "Must provide 2, 4, 6, 8, or 10 args.";;
# esac
if (($# % 2)) || (($# < 2)) || (($# > 10)); then
    echo >&2 "Must provide 2, 4, 6, 8, or 10 args."
    exit $(($# + 100))
fi

while (( $# > 0 )); do
    guess="${1,,}"
    result="${2//[-_]/.}"
    [[ "$guess" =~ ^[a-zA-Z]{5}$ ]] || { echo >&2 "Invalid guess: $guess"; exit 99; }
    [[ "$result" =~ ^[.a-zA-Z]{5}$ ]] || { echo >&2 "Invalid result: $result"; exit 99; }
    [[ "$guess" =~ ${result,,} ]] || { echo >&2 "Result ${result} does not match guess ${guess}."; exit 99; }
    if (( ${#guess} != 5 || ${#result} != 5 )); then
        # TODO: allow single-char null result?
        echo >&2 "Args must be 5 characters long."
        exit 99
    fi

    declare -a answer yellows
    declare -l grays
    for (( i=0; i<${#result}; i++ )); do
        guess_char="${guess:$i:1}"
        result_char="${result:$i:1}"
        case "$result_char" in
            [[:upper:]] ) answer[$i]="$guess_char";;
            [[:lower:]] ) yellows[$i]+="$guess_char";;  # TODO: Handle secondary yellows!
            . ) grays+="$guess_char";;  # TODO: Handle secondary grays!
            # e.g. ./wordle sLaTe S.... hokum .o... scorn S.O.n snoop SNO.. ?
        esac

        # something
    done

    # something
    shift 2
done

# declare -p answer yellows grays

declare -l pattern='/^'
for (( i=0; i<5; i++ )); do
    if [[ -v answer[$i] ]]; then
        pattern+="${answer[$i]}"
    elif (( ${#yellows[$i]} || ${#grays} )); then
        pattern+="[^${yellows[$i]}${grays}]"
    else
        pattern+='.'
    fi
done
pattern+='$/'
# declare -p pattern
printf -v all_yellows '%s' "${yellows[@]}"
for (( i=0; i<${#all_yellows}; i++ )); do
    pattern+=" && /${all_yellows:$i:1}/"
done
# declare -p pattern
# echo "$pattern"
# echo "awk '$pattern' words"
# readarray -t poss < <(awk "$pattern" words)
poss="$(awk "$pattern" words)"
# declare -p poss
if [ -t 1 ]; then
    echo "$(wc -l <<< "${poss[@]}") possible answers:"
    <<< "${poss[@]}" column --output-width 80
else
    echo "${poss}"
fi
